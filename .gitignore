
# Generated content + downloaded/uploaded assets (operator-local; promote explicitly when needed)
content/
assets/

# Automaton runtime files (auto-added by automaton)
# Automaton turn-limit resume marker — ephemeral, must not be tracked (v0.33.37)
.code-continue.yaml
# Feature tick-frequency mutations — gitignored so per-run state never generates commit churn (v0.32.0)
features/**/*.mutate.yaml
# Task tick-frequency mutations — same partition as features (v0.32.0)
tasks/**/*.mutate.yaml

# Common noise (auto-added by automaton)
# Windows-bash `> nul` redirect creates literal file named 'nul'
nul
# TestCafe / Playwright screenshot output on test failures
screenshots/
# Regenerated by the prioritizer every cycle — local runtime state, not history
priorities.yaml
# help-refresher reconcile marker — regenerable, churns on every reconcile
docs/help/.help-meta.json
# screens-annotator delta-gate cache — regenerable, rewritten every tick
.screens-annotator-state.yaml
# Machine-generated symbol index — regenerated by context refresh / code command
CODEMAP.json
# CODEMAP impact metrics — appended per coding run, regenerable
codemap-metrics.yaml
